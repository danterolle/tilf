QMainWindow,
QDialog {
    background-color: #0b1219;
    color: #88e0f6;
}

QWidget {
    color: #88e0f6;
    font-family: "IBM Plex Sans", "SF Pro Text", "Segoe UI", sans-serif;
    selection-background-color: #5aafc3;
    selection-color: #071016;
}

QMenuBar {
    background-color: #131c23;
    color: #88e0f6;
    border-bottom: 1px solid #2a3a44;
    padding: 2px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #162029;
    color: #b9f2ff;
}

QMenu {
    background-color: #131c23;
    color: #88e0f6;
    border: 1px solid #2a3a44;
    padding: 6px;
}

QMenu::item {
    padding: 7px 28px 7px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background-color: #5aafc3;
    color: #071016;
}

QMenu::separator {
    height: 1px;
    background-color: #2a3a44;
    margin: 6px 4px;
}

QToolBar {
    background-color: #131c23;
    spacing: 5px;
    padding: 8px;
    border-bottom: 1px solid #2a3a44;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 7px;
    color: #88e0f6;
    border-radius: 8px;
}

QToolButton:hover {
    background-color: #162029;
    border-color: #31505c;
    color: #b9f2ff;
}

QToolButton:pressed {
    background-color: #5aafc3;
    color: #071016;
}

QToolButton:checked {
    background-color: #5aafc3;
    color: #071016;
    border: 1px solid #88e0f6;
    font-weight: bold;
}

QToolButton:disabled {
    color: #44616b;
    background-color: transparent;
    border-color: transparent;
}

QToolBar::separator {
    background-color: #2a3a44;
    width: 1px;
    margin: 5px 7px;
}

QStatusBar {
    background-color: #131c23;
    color: #88e0f6;
    border-top: 1px solid #2a3a44;
    padding: 3px;
    font-family: "JetBrains Mono", "SF Mono", monospace;
}

QScrollArea {
    background-color: #071016;
    border: none;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #0b1219;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #2a3a44;
    border-radius: 4px;
    min-height: 28px;
    min-width: 28px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #31505c;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QDockWidget {
    background-color: #0b1219;
    color: #88e0f6;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #131c23;
    color: #b9f2ff;
    border-bottom: 1px solid #2a3a44;
    padding: 8px;
    font-weight: bold;
}

QWidget#inspectorPanel {
    background-color: #0b1219;
}

QLabel#previewLabel {
    background-color: #071016;
    border: 1px solid #2a3a44;
    border-radius: 10px;
    padding: 8px;
}

QLabel#missingIconLabel {
    border: 1px dashed #5aafc3;
    border-radius: 8px;
    color: #88e0f6;
}

QFrame#aboutCard {
    background-color: #131c23;
    border: 1px solid #2a3a44;
    border-radius: 14px;
}

QFrame#confirmCard {
    background-color: #131c23;
    border: 1px solid #2a3a44;
    border-radius: 14px;
}

QFrame#confirmAccent {
    background-color: #5aafc3;
    border-radius: 2px;
}

QLabel#confirmTitle {
    color: #b9f2ff;
    font-size: 18px;
    font-weight: bold;
}

QLabel#confirmMessage {
    color: #88e0f6;
    font-size: 14px;
}

QLabel#aboutTitle {
    color: #b9f2ff;
    font-family: "VT323", "JetBrains Mono", monospace;
    font-size: 36px;
    font-weight: bold;
}

QLabel#aboutVersion {
    color: #5aafc3;
    font-family: "JetBrains Mono", "SF Mono", monospace;
    font-size: 13px;
}

QLabel#aboutDescription {
    color: #88e0f6;
    font-size: 14px;
    line-height: 1.4;
}

QLabel#aboutMeta {
    color: #6aaebd;
    font-size: 12px;
}

QGroupBox {
    background-color: #131c23;
    border: 1px solid #2a3a44;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #88e0f6;
    font-weight: bold;
}

QLabel {
    color: #88e0f6;
}

QSpinBox,
QComboBox,
QPushButton {
    color: #88e0f6;
    background-color: #162029;
    border: 1px solid #2a3a44;
    padding: 6px 8px;
    border-radius: 7px;
    min-height: 24px;
}

QSpinBox {
    padding-right: 34px;
}

QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: border;
    width: 24px;
    background-color: #131c23;
    border-left: 1px solid #2a3a44;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 7px;
    border-bottom: 1px solid #2a3a44;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 7px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #1b333d;
    border-color: #5aafc3;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background-color: #5aafc3;
}

QSpinBox::up-arrow {
    image: url("__SPINBOX_UP_ICON__");
    width: 12px;
    height: 12px;
}

QSpinBox::down-arrow {
    image: url("__SPINBOX_DOWN_ICON__");
    width: 12px;
    height: 12px;
}

QSpinBox::up-arrow:disabled,
QSpinBox::down-arrow:disabled {
    opacity: 0.45;
}

QSpinBox:hover,
QComboBox:hover,
QPushButton:hover {
    background-color: #1b333d;
    border-color: #5aafc3;
}

QSpinBox:focus,
QComboBox:focus,
QPushButton:focus {
    border-color: #88e0f6;
}

QPushButton:pressed {
    background-color: #5aafc3;
    color: #071016;
}

QPushButton:disabled {
    color: #44616b;
    background-color: #131c23;
    border-color: #243044;
}

QPushButton[variant="primary"] {
    background-color: #5aafc3;
    color: #071016;
    border-color: #88e0f6;
    font-weight: bold;
}

QPushButton[variant="secondary"] {
    background-color: #162029;
    color: #88e0f6;
    border-color: #2a3a44;
}

QPushButton[variant="danger"] {
    background-color: #7f1d1d;
    color: #fee2e2;
    border-color: #ef4444;
    font-weight: bold;
}

QPushButton[variant="primary"]:hover {
    background-color: #88e0f6;
}

QPushButton[variant="secondary"]:hover {
    background-color: #1b333d;
    border-color: #5aafc3;
    color: #b9f2ff;
}

QPushButton[variant="danger"]:hover {
    background-color: #991b1b;
}

QPushButton[variant="primary"]:pressed,
QPushButton[variant="secondary"]:pressed {
    background-color: #5aafc3;
    color: #071016;
}

QComboBox::drop-down {
    width: 26px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #131c23;
    color: #88e0f6;
    border: 1px solid #2a3a44;
    selection-background-color: #5aafc3;
    selection-color: #071016;
}

QSlider::groove:horizontal {
    height: 6px;
    background-color: #2a3a44;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #5aafc3;
    border: 2px solid #0b1219;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #88e0f6;
}
